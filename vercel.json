{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth",
      "destination": "/api/auth?__subpath="
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?__subpath=:path*"
    },
    {
      "source": "/api/user",
      "destination": "/api/user?__subpath="
    },
    {
      "source": "/api/user/:path*",
      "destination": "/api/user?__subpath=:path*"
    },
    {
      "source": "/api/license",
      "destination": "/api/license?__subpath="
    },
    {
      "source": "/api/license/:path*",
      "destination": "/api/license?__subpath=:path*"
    },
    {
      "source": "/api/admin",
      "destination": "/api/admin?__subpath="
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/api/admin?__subpath=:path*"
    },
    {
      "source": "/quan-tri",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
